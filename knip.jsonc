{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  // Dynamic extension entrypoints carry this tag because consumers load them by file path.
  "tags": ["-knipignore"],
  "ignoreWorkspaces": [
    // Test fixtures are not part of Station's shipped production graph.
    "packages/testing!"
  ],
  "ignoreBinaries": [
    // System-level development dependencies are installed and validated outside Bun.
    "cc",
    "sshpass",
    "tart"
  ],
  "ignoreUnresolved": [
    // This is the executable root package script, not a module specifier.
    "bin/stn"
  ],
  "workspaces": {
    ".": {
      "entry": [
        // These helpers are launched by path strings, so static imports cannot prove reachability.
        "scripts/enable-devbox-codex-hooks.mjs",
        "scripts/native-hmr-runner.mjs",
        "scripts/setup/setup-guided-sandbox.mjs",
        "scripts/station-tmux-devbox.mjs",
        "scripts/test-runners/sqlite-runtime-probe.mjs",
        "tools/architecture/serve-observer-architecture.mjs",
        "tools/lint/check-observer-architecture.mjs",
        "tests/support/observerMain.js",
        "tests/agent/real/pi/fixtures/station-extension-protocol-v1.mjs",
        "tests/diagnostics/fixtures/vitest-machine-isolation/*.fixture.ts",
        "tests/diagnostics/fixtures/vitest-machine-isolation/vitest.config.ts"
      ],
      "project": [
        "config/**/*.ts",
        "scripts/**/*.mjs",
        "tests/**/*.{js,mjs,ts,tsx}",
        "tools/**/*.mjs"
      ]
    },
    "apps/cli": {
      "project": ["src/**/*.ts!", "test/**/*.{ts,tsx}"]
    },
    "apps/observer": {
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}!", "test/**/*.{ts,tsx}"]
    },
    "integrations/*/*": {
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "integrations/harness/scripted": {
      "project": ["src/**/*.ts!", "scripts/**/*.mjs!", "test/**/*.ts"]
    },
    "station": {
      "entry": [
        // Knip treats only a package's start script as production, so these Bun scripts stay explicit.
        "src/main.tsx!",
        "src/dashboardRenderer/main.tsx!",
        "src/bin/stnMain.ts!",
        "src/host/hostMain.ts!",
        "src/terminal/pty/localPtyBridge.cjs!",
        "scripts/e2eReattachDemo.ts",
        "src/host/listHostAgents.ts",
        "src/**/*.{test,spec}.{ts,tsx}",
        "src/**/*.smoke.test.ts",
        "src/terminal/pty/fixtures/piCapabilitiesProbe.ts"
      ],
      "project": [
        "src/**/*.{cjs,ts,tsx}!",
        "!src/**/*.{test,spec}.{ts,tsx}!",
        "!src/**/*.smoke.test.ts!",
        "!src/**/test/**!",
        "!src/copy/testing.ts!",
        "!src/terminal/testing/**!",
        "!src/terminal/vt/cases/**!"
      ]
    }
  }
}
