{
  "name": "station",
  "version": "0.0.0-pre-alpha.5.16",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "stn": "./bin/stn",
    "stn-ingress": "./bin/stn-ingress",
    "stn-tmux-popup": "./integrations/terminal/tmux/bin/stn-popup"
  },
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=24.2 <25",
    "pnpm": "11.0.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "node scripts/build-identity.mjs",
    "build:binary": "bun scripts/build-binary.mjs",
    "setup:system": "scripts/setup/setup-system-dependencies.sh",
    "setup:system:check": "scripts/setup/setup-system-dependencies.sh --check",
    "setup:guided:sandbox": "node scripts/setup/setup-guided-sandbox.mjs",
    "agent:cleanup": "node scripts/maintenance/agent-cleanup.mjs",
    "agent:cleanup:run": "node scripts/maintenance/agent-cleanup.mjs --run",
    "agent:reset": "node scripts/maintenance/agent-reset.mjs",
    "agent:reset:run": "node scripts/maintenance/agent-reset.mjs --yes",
    "station:runtime-inventory": "node scripts/maintenance/runtime-inventory.mjs",
    "station:runtime-prune": "node scripts/maintenance/runtime-prune.mjs",
    "stn": "bin/stn",
    "station:reset": "node scripts/maintenance/station-reset.mjs",
    "station:reset:tmux-tui": "node scripts/maintenance/station-tmux-tui-reset.mjs",
    "station:tui-dev": "node scripts/tui-dev.mjs",
    "station:ui-dev": "cd station && bun run dev",
    "stn-ingress": "bin/stn-ingress",
    "station:link": "pnpm add --global .",
    "dev": "node scripts/tui-dev.mjs",
    "station:devbox": "node scripts/station-devbox.mjs",
    "station:devbox:smoke": "node scripts/test-runners/run-station-devbox-smoke.mjs",
    "station:devbox:tmux:smoke": "node scripts/test-runners/run-station-tmux-devbox-smoke.mjs",
    "station:sessions:save": "node scripts/maintenance/session-rescue.mjs save",
    "station:sessions:verify": "node scripts/maintenance/session-rescue.mjs verify",
    "station:sessions:migrate": "node scripts/maintenance/session-migrate.mjs",
    "smoke:binary": "node scripts/test-runners/run-binary-smoke.mjs",
    "smoke:update": "node scripts/test-runners/run-update-smoke.mjs",
    "stress:binary-handoff": "node scripts/test-runners/run-binary-smoke.mjs --mode handoff-stress",
    "smoke:install": "node scripts/test-runners/run-install-smoke.mjs",
    "typecheck": "turbo run typecheck",
    "architecture:observer:generate": "node tools/lint/check-observer-architecture.mjs --write",
    "architecture:observer:check": "node tools/lint/check-observer-architecture.mjs",
    "architecture:observer:visualize": "pnpm architecture:observer:check && node tools/architecture/serve-observer-architecture.mjs",
    "lint": "biome check . && node tools/lint/check-no-raw-hex.mjs && node tools/lint/check-no-raw-vt-literals.mjs && pnpm architecture:observer:check",
    "format": "biome format --write .",
    "deadcode": "knip --no-config-hints",
    "deadcode:production": "knip --production --no-config-hints",
    "test:unit": "vitest run --config config/vitest/vitest.unit.config.ts",
    "test:contracts": "vitest run --config config/vitest/vitest.contracts.config.ts",
    "test:integration": "pnpm build && vitest run --config config/vitest/vitest.integration.config.ts",
    "benchmark:quick-session": "STATION_QUICK_SESSION_BENCHMARK_OUTPUT=.dev-state/performance/quick-session/latest.synthetic.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/benchmark.test.ts",
    "benchmark:quick-session:real": "STATION_REAL_QUICK_SESSION=1 STATION_REAL_QUICK_SESSION_BENCHMARK_OUTPUT=.dev-state/performance/quick-session/observer-worktrunk.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/observerWorktrunk.real.test.ts",
    "benchmark:quick-session:worktrunk": "node tests/performance/quick-session/worktrunkConcurrency.mjs",
    "benchmark:quick-session:native-git": "node tests/performance/quick-session/nativeGitCreateComparison.mjs",
    "benchmark:quick-session:native-git-bare-singleflight": "node tests/performance/quick-session/nativeGitBareSingleflightComparison.mjs",
    "benchmark:quick-session:native-git-bound-three": "node tests/performance/quick-session/nativeGitBoundThreeComparison.mjs",
    "benchmark:quick-session:native-git-remove": "node tests/performance/quick-session/nativeGitRemoveComparison.mjs",
    "benchmark:quick-session:native-git-concurrency": "node tests/performance/quick-session/nativeGitConcurrency.mjs",
    "benchmark:quick-session:native-git-adaptive-overflow": "STATION_NATIVE_GIT_CONCURRENCY_MODE=adaptive-overflow STATION_NATIVE_GIT_CONCURRENCY_BENCHMARK_OUTPUT=.dev-state/performance/quick-session/native-git-adaptive-overflow.real.json node tests/performance/quick-session/nativeGitConcurrency.mjs",
    "benchmark:quick-session:native-git-list": "node tests/performance/quick-session/nativeGitListComparison.mjs",
    "benchmark:quick-session:startup-read-paired": "node tests/performance/quick-session/startupReadPairedComparison.mjs",
    "benchmark:quick-session:startup-enrichment-hybrid": "STATION_STARTUP_READ_COMPARISON_MODE=hybrid STATION_STARTUP_READ_PAIRED_BENCHMARK_OUTPUT=.dev-state/performance/quick-session/startup-enrichment-hybrid-comparison.real.json node tests/performance/quick-session/startupReadPairedComparison.mjs",
    "benchmark:quick-session:startup-discovery-deferred": "STATION_STARTUP_READ_COMPARISON_MODE=deferred STATION_STARTUP_READ_PAIRED_BENCHMARK_OUTPUT=.dev-state/performance/quick-session/deferred-startup-discovery-comparison.real.json node tests/performance/quick-session/startupReadPairedComparison.mjs",
    "benchmark:quick-session:pooled-worktree": "node tests/performance/quick-session/pooledWorktreeActivationComparison.mjs",
    "benchmark:quick-session:pooled-worktree-five-slot": "STATION_POOLED_WORKTREE_POOL_SIZE=5 STATION_POOLED_WORKTREE_BENCHMARK_OUTPUT=.dev-state/performance/quick-session/pooled-worktree-five-slot-comparison.real.json node tests/performance/quick-session/pooledWorktreeActivationComparison.mjs",
    "benchmark:quick-session:pooled-worktree-five-slot-phased": "STATION_POOLED_WORKTREE_POOL_SIZE=5 STATION_POOLED_WORKTREE_FALLBACK_SCHEDULING=phased STATION_POOLED_WORKTREE_BENCHMARK_OUTPUT=.dev-state/performance/quick-session/pooled-worktree-five-slot-phased.real.json node tests/performance/quick-session/pooledWorktreeActivationComparison.mjs",
    "benchmark:quick-session:native-git-verification": "node tests/performance/quick-session/nativeGitVerificationComparison.mjs",
    "benchmark:quick-session:pty": "STATION_REAL_QUICK_SESSION_PTY=1 STATION_REAL_QUICK_SESSION_PTY_OUTPUT=.dev-state/performance/quick-session/quick-session-pty.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/quickSessionPty.real.test.ts",
    "benchmark:quick-session:host-prewarm": "STATION_REAL_HOST_PREWARM=1 STATION_REAL_HOST_PREWARM_OUTPUT=.dev-state/performance/quick-session/host-prewarm-comparison.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/hostPrewarmComparison.real.test.ts",
    "benchmark:quick-session:host-prewarm-compiled": "STATION_REAL_COMPILED_HOST_PREWARM=1 STATION_REAL_HOST_PREWARM_OUTPUT=.dev-state/performance/quick-session/compiled-host-prewarm.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/hostPrewarmComparison.real.test.ts",
    "benchmark:quick-session:host-prewarm-compiled-cached": "STATION_REAL_COMPILED_HOST_PREWARM_CACHED=1 STATION_REAL_HOST_PREWARM_OUTPUT=.dev-state/performance/quick-session/compiled-host-prewarm-cached.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/hostPrewarmComparison.real.test.ts",
    "benchmark:quick-session:host-prewarm-compiled-observer": "STATION_REAL_COMPILED_HOST_PREWARM_OBSERVER=1 STATION_REAL_HOST_PREWARM_OUTPUT=.dev-state/performance/quick-session/compiled-host-prewarm-observer.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/hostPrewarmComparison.real.test.ts",
    "benchmark:quick-session:host-observer-restart-live": "STATION_REAL_COMPILED_HOST_RESTART_LIVE=1 STATION_REAL_HOST_PREWARM_OUTPUT=.dev-state/performance/quick-session/compiled-host-observer-restart-live.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/hostPrewarmComparison.real.test.ts",
    "benchmark:quick-session:host-observer-restart-phases": "STATION_REAL_COMPILED_HOST_RESTART_PHASES=1 STATION_REAL_HOST_PREWARM_OUTPUT=.dev-state/performance/quick-session/compiled-host-observer-restart-phases.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/hostPrewarmComparison.real.test.ts",
    "benchmark:quick-session:host-observer-cross-process": "STATION_REAL_COMPILED_HOST_OBSERVER_CROSS_PROCESS=1 STATION_REAL_HOST_PREWARM_OUTPUT=.dev-state/performance/quick-session/compiled-host-observer-cross-process.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/hostPrewarmComparison.real.test.ts",
    "benchmark:quick-session:compiled-native-tui": "STATION_REAL_COMPILED_QUICK_SESSION_TUI=1 STATION_REAL_COMPILED_QUICK_SESSION_TUI_OUTPUT=.dev-state/performance/quick-session/compiled-quick-session-tui.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/compiledQuickSessionTui.real.test.ts",
    "benchmark:quick-session:compiled-native-focus": "STATION_REAL_COMPILED_QUICK_SESSION_TUI_FOCUS_COMPARE=1 STATION_REAL_COMPILED_QUICK_SESSION_TUI_OUTPUT=.dev-state/performance/quick-session/compiled-quick-session-focus.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/compiledQuickSessionTui.real.test.ts",
    "benchmark:quick-session:compiled-native-safety": "STATION_REAL_COMPILED_QUICK_SESSION_TUI_SAFETY_AUDIT=1 STATION_REAL_COMPILED_QUICK_SESSION_TUI_OUTPUT=.dev-state/performance/quick-session/compiled-quick-session-safety.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/compiledQuickSessionTui.real.test.ts",
    "benchmark:quick-session:host-entry": "STATION_REAL_HOST_ENTRY_COMPARISON=1 STATION_REAL_HOST_ENTRY_COMPARISON_OUTPUT=.dev-state/performance/quick-session/host-entry-comparison.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/hostEntryComparison.real.test.ts",
    "benchmark:quick-session:host-entry-compiled": "STATION_REAL_COMPILED_HOST_ENTRY=1 STATION_REAL_COMPILED_HOST_ENTRY_OUTPUT=.dev-state/performance/quick-session/compiled-host-entry.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/compiledHostEntry.real.test.ts",
    "benchmark:quick-session:host-entry-compiled-assets": "STATION_REAL_COMPILED_HOST_ASSET=1 STATION_REAL_COMPILED_HOST_ASSET_OUTPUT=.dev-state/performance/quick-session/compiled-host-asset-comparison.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/compiledHostEntry.real.test.ts",
    "benchmark:quick-session:host-entry-compiled-milestones": "STATION_REAL_COMPILED_HOST_MILESTONES=1 STATION_REAL_COMPILED_HOST_MILESTONES_OUTPUT=.dev-state/performance/quick-session/compiled-host-milestones.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/compiledHostEntry.real.test.ts",
    "benchmark:quick-session:host-entry-dedicated-binary": "STATION_REAL_DEDICATED_HOST_BINARY=1 STATION_REAL_DEDICATED_HOST_BINARY_OUTPUT=.dev-state/performance/quick-session/dedicated-host-binary-comparison.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/compiledHostEntry.real.test.ts",
    "benchmark:quick-session:host-entry-compiled-sequence": "STATION_REAL_COMPILED_HOST_SEQUENCE=1 STATION_REAL_COMPILED_HOST_SEQUENCE_OUTPUT=.dev-state/performance/quick-session/compiled-host-sequence.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/compiledHostEntry.real.test.ts",
    "benchmark:quick-session:end-to-end": "STATION_REAL_QUICK_SESSION=1 STATION_REAL_QUICK_SESSION_HOST_PTY=1 STATION_REAL_QUICK_SESSION_BENCHMARK_OUTPUT=.dev-state/performance/quick-session/observer-host-pty.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/observerWorktrunk.real.test.ts",
    "benchmark:quick-session:end-to-end-paired": "STATION_REAL_QUICK_SESSION=1 STATION_REAL_QUICK_SESSION_HOST_PTY=1 STATION_REAL_QUICK_SESSION_PAIRED_TERMINAL=1 STATION_REAL_QUICK_SESSION_BENCHMARK_OUTPUT=.dev-state/performance/quick-session/observer-host-pty-paired.real.json vitest run --config config/vitest/vitest.performance.config.ts tests/performance/quick-session/observerWorktrunk.real.test.ts",
    "test:observer-claim:cross-runtime": "node scripts/test-runners/run-observer-claim-cross-runtime.mjs",
    "test:observer-claim:cross-runtime:pr": "node scripts/test-runners/run-observer-claim-cross-runtime.mjs --rounds 5 --three-contender-rounds 2",
    "test:sqlite:bun": "node scripts/test-runners/run-sqlite-cross-runtime.mjs && pnpm test:observer-claim:cross-runtime",
    "test:sqlite:bun:pr": "node scripts/test-runners/run-sqlite-cross-runtime.mjs && pnpm test:observer-claim:cross-runtime:pr",
    "test:diagnostics": "vitest run --config config/vitest/vitest.diagnostics.config.ts",
    "test:diagnostics:policy": "vitest run --config config/vitest/vitest.diagnostics.config.ts tests/diagnostics/ci-classification.test.ts tests/diagnostics/ci-workflow-policy.test.ts tests/diagnostics/release-readiness-docs.test.ts tests/diagnostics/vitest-machine-isolation-policy.test.ts",
    "test:e2e:setup": "vitest run --config config/vitest/vitest.setup-e2e.config.ts",
    "test:e2e:setup:guided": "node scripts/test-runners/run-setup-guided-e2e.mjs",
    "test:e2e:setup:guided:all-shells": "STATION_SETUP_E2E_ALL_SHELLS=true pnpm test:e2e:setup:guided",
    "test:e2e:setup:core": "vitest run --config config/vitest/vitest.setup-e2e.config.ts tests/e2e/setup-core-flow.test.ts",
    "test:e2e:setup:sqlite": "vitest run --config config/vitest/vitest.setup-e2e.config.ts tests/e2e/observer-sqlite-smoke.test.ts",
    "test:e2e:observer": "vitest run --config config/vitest/vitest.e2e.config.ts tests/e2e/observer-lifecycle.test.ts tests/e2e/session-migration.test.ts tests/e2e/full-session-lifecycle/session-create-scripted.test.ts",
    "test:e2e:codex-hook-reconciliation": "vitest run --config config/vitest/vitest.e2e.config.ts tests/e2e/codex-hook-reconciliation.test.ts",
    "test:e2e:host-upgrade": "pnpm --dir station test:host:upgrade",
    "test:e2e": "vitest run --config config/vitest/vitest.e2e.config.ts",
    "test:e2e:real": "vitest run --config config/vitest/vitest.real-e2e.config.ts",
    "test:e2e:real:local": "node scripts/test-runners/run-real-e2e.mjs",
    "test:e2e:real:codex-hooks": "node scripts/test-runners/run-real-e2e.mjs tests/e2e/real/real-codex-hooks.test.ts",
    "test:e2e:real:codex-hooks:keep-temp": "node scripts/test-runners/run-real-e2e.mjs --keep-temp tests/e2e/real/real-codex-hooks.test.ts",
    "test:e2e:worktrunk:real": "vitest run --config config/vitest/vitest.worktrunk-real.config.ts",
    "test:tmux-popup:real": "vitest run --config config/vitest/vitest.tmux-popup-real.config.ts",
    "test:e2e:claude:real": "vitest run --config config/vitest/vitest.claude-real.config.ts",
    "test:e2e:codex:real": "vitest run --config config/vitest/vitest.codex-real.config.ts",
    "test:e2e:cursor:real": "vitest run --config config/vitest/vitest.cursor-real.config.ts",
    "test:e2e:pi:real": "vitest run --config config/vitest/vitest.pi-real.config.ts",
    "test:e2e:opencode:real": "vitest run --config config/vitest/vitest.opencode-real.config.ts",
    "test:agent:scripted": "vitest run --config config/vitest/vitest.agent-scripted.config.ts",
    "test:agent:real": "pnpm test:e2e:codex:real",
    "test:agent:nightly": "STATION_REAL_CLAUDE=1 pnpm test:e2e:claude:real",
    "smoke:release": "node scripts/test-runners/run-release-smoke.mjs",
    "test:env:docker": "node scripts/test-runners/run-setup-container.mjs",
    "test:ci:fast": "pnpm build && pnpm test:unit && pnpm test:contracts && pnpm test:diagnostics && pnpm test:agent:scripted",
    "test:ci:station": "pnpm --dir station typecheck && pnpm --dir station test && pnpm --dir station test:pty && pnpm --dir station test:pty:bun && pnpm test:e2e:host-upgrade",
    "test:ci:binary": "pnpm build:binary -- --version 0.0.0-local && pnpm smoke:binary -- --expected-version 0.0.0-local && pnpm smoke:update -- --incumbent-binary station/dist/bin/stn --incumbent-version 0.0.0-local --target-source-version 0.0.1-local --busy-host-outcome preserved-refusal",
    "test:all": "pnpm build && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:contracts && pnpm test:integration && pnpm benchmark:quick-session && pnpm test:diagnostics && pnpm test:agent:scripted && pnpm test:e2e:setup && pnpm test:e2e:observer && pnpm smoke:install",
    "test:pre-push": "pnpm lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/node": "^24.12.4",
    "@typescript/typescript6": "6.0.2",
    "d3": "^7.9.0",
    "knip": "^6.29.0",
    "lefthook": "^1.13.6",
    "turbo": "^2.9.15",
    "typescript": "7.0.2",
    "vitest": "^3.2.4",
    "zod": "^4.1.12"
  }
}
