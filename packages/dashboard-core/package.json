{
  "name": "@station/dashboard-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./dist/entrypoints/runtime.d.ts",
      "import": "./dist/entrypoints/runtime.js"
    },
    "./state": {
      "types": "./dist/entrypoints/state.d.ts",
      "import": "./dist/entrypoints/state.js"
    },
    "./selectors": {
      "types": "./dist/entrypoints/selectors.d.ts",
      "import": "./dist/entrypoints/selectors.js"
    },
    "./text": {
      "types": "./dist/entrypoints/text.d.ts",
      "import": "./dist/entrypoints/text.js"
    },
    "./widgets": {
      "types": "./dist/entrypoints/widgets.d.ts",
      "import": "./dist/entrypoints/widgets.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json"
  },
  "dependencies": {
    "@station/client": "workspace:*",
    "@station/contracts": "workspace:*",
    "@station/runtime": "workspace:*",
    "string-width": "^8.2.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.14"
  }
}
