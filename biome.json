{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**"]
  },
  "plugins": ["./tools/lint/no-one-to-one-aliases.grit"],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": ["station/**"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "recommended": false,
          "a11y": "off",
          "complexity": {
            "noUselessEscapeInRegex": "error",
            "useOptionalChain": "error"
          },
          "correctness": {
            "useExhaustiveDependencies": "error"
          },
          "nursery": "off",
          "performance": "off",
          "security": "off",
          "style": {
            "noNonNullAssertion": "error",
            "useImportType": "error",
            "useTemplate": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noControlCharactersInRegex": "off",
            "noImplicitAnyLet": "error",
            "noTemplateCurlyInString": "off",
            "noUselessEscapeInString": "error"
          }
        }
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": ["station/**/*.test.{ts,tsx}", "station/**/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
