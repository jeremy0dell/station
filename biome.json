{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**"]
  },
  "plugins": ["./tools/lint/no-one-to-one-aliases.grit"],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": ["station/**"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "recommended": false,
          "a11y": "off",
          "complexity": "off",
          "correctness": "off",
          "nursery": "off",
          "performance": "off",
          "security": "off",
          "style": "off",
          "suspicious": "off"
        }
      },
      "assist": {
        "enabled": false
      }
    }
  ]
}
